<% html_title(t("flightplan.board.title")) %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { t("flightplan.board.title") }
    header.with_breadcrumbs(nil)
  end
%>

<div id="fp-board-alert" class="op-toast -error mb-2" hidden></div>

<div class="fp-filters">
  <nav class="fp-chips" aria-label="<%= t("flightplan.board.bereiche") %>">
    <%= link_to flightplan_board_path(@board.params_for(bereich: nil, projects: nil)), class: "fp-chip #{'is-on' if @board.selected_bereich.blank?}", data: { bereich: "all", turbo: false } do %>
      <%= t("flightplan.board.all") %>
      <span><%= @board.bereiche.sum { |row| row[:open_count] } %></span>
    <% end %>
    <% @board.bereiche.each do |choice| %>
      <%= link_to flightplan_board_path(@board.params_for(bereich: choice[:identifier], projects: nil)), class: "fp-chip #{'is-on' if choice[:selected]}", data: { bereich: choice[:identifier], open: choice[:open_count], turbo: false } do %>
        <%= choice[:name] %>
        <span><%= choice[:open_count] %></span>
      <% end %>
    <% end %>
  </nav>

  <nav class="fp-chips" aria-label="<%= t("flightplan.board.projects") %>">
    <%= link_to flightplan_board_path(@board.params_for(projects: nil)), class: "fp-chip #{'is-on' if @board.selected_projects.empty?}", data: { project: "all", open: @board.all_open_count, turbo: false } do %>
      <%= t("flightplan.board.all") %>
      <span><%= @board.all_open_count %></span>
    <% end %>
    <% @board.projects.each do |choice| %>
      <% next_ids = choice[:selected] ? (@board.selected_projects - [choice[:identifier]]) : (@board.selected_projects + [choice[:identifier]]) %>
      <%= link_to flightplan_board_path(@board.params_for(projects: next_ids.join(",").presence)), class: "fp-chip #{'is-on' if choice[:selected]}", data: { project: choice[:identifier], open: choice[:open_count], turbo: false } do %>
        <%= choice[:name] %>
        <span><%= choice[:open_count] %></span>
      <% end %>
    <% end %>
    <%= link_to t("flightplan.board.inbox"), root_path(Flightplan::QuestionsWidget::PARAM => Flightplan::QuestionsWidget.scope_for(identifiers: @board.selected_projects)), class: "fp-chip", data: { turbo: false } %>
  </nav>

  <%= form_with url: flightplan_board_path, method: :get, local: true, class: "fp-search", data: { turbo: false } do %>
    <% if @board.selected_bereich.present? %>
      <%= hidden_field_tag :bereich, @board.selected_bereich %>
    <% end %>
    <% if @board.selected_projects.any? %>
      <%= hidden_field_tag :projects, @board.selected_projects.join(",") %>
    <% end %>
    <% if @board.selected_labels.any? %>
      <%= hidden_field_tag :labels, @board.selected_labels.join(",") %>
    <% end %>
    <% if @board.selected_agents.any? %>
      <%= hidden_field_tag :agents, @board.selected_agents.join(",") %>
    <% end %>
    <% if @board.show_rejected? %>
      <%= hidden_field_tag :rejected, "1" %>
    <% end %>
    <% if @board.done_all? %>
      <%= hidden_field_tag :done, "all" %>
    <% end %>
    <% @board.limits.each do |key, value| %>
      <% next if value <= Flightplan::Board::PAGE %>
      <%= hidden_field_tag "limits[#{key}]", value %>
    <% end %>
    <label>
      <%= t("flightplan.board.search") %>
      <%= text_field_tag :q, @board.query_text, class: "FormControl-input", placeholder: t("flightplan.board.search_placeholder") %>
    </label>
  <% end %>

  <nav class="fp-chips" aria-label="<%= t("flightplan.board.labels") %>">
    <% @board.label_options.each do |option| %>
      <% next_labels = option[:selected] ? (@board.selected_labels - [option[:name]]) : (@board.selected_labels + [option[:name]]) %>
      <%= link_to option[:name],
            flightplan_board_path(@board.params_for(labels: next_labels.join(",").presence)),
            class: "fp-label-chip #{'is-on' if option[:selected]}",
            style: "background-color:##{option[:color]};color:##{option[:ink]}",
            data: { label: option[:name], turbo: false } %>
    <% end %>
  </nav>

  <nav class="fp-chips" aria-label="<%= t("flightplan.board.agents") %>">
    <% @board.agent_options.each do |option| %>
      <% next_agents = option[:selected] ? (@board.selected_agents - [option[:key]]) : (@board.selected_agents + [option[:key]]) %>
      <%= link_to option[:label],
            flightplan_board_path(@board.params_for(agents: next_agents.join(",").presence)),
            class: "fp-chip #{'is-on' if option[:selected]}",
            data: { agent: option[:key], turbo: false } %>
    <% end %>
    <%= link_to t("flightplan.board.rejected_show"),
          flightplan_board_path(@board.params_for(rejected: (@board.show_rejected? ? nil : "1"))),
          class: "fp-chip #{'is-on' if @board.show_rejected?}",
          data: { turbo: false } %>
  </nav>

  <nav class="fp-chips" aria-label="<%= t("flightplan.board.wiki") %>">
    <% @board.wiki_projects.each do |wiki| %>
      <%= link_to "#{wiki[:name]} #{t("flightplan.board.wiki")}", wiki[:href], class: "fp-chip", data: { wiki: wiki[:href], turbo: false } %>
    <% end %>
  </nav>
</div>

<div class="fp-board-layout">
  <div id="fp-board"
       class="fp-board-scroll"
       data-move-url="<%= flightplan_board_move_path %>"
       data-csrf="<%= form_authenticity_token %>">
    <% @board.columns.each do |column| %>
      <section class="fp-column" data-column="<%= column.key %>" data-count="<%= column.count %>" data-status="<%= column.status %>">
        <header class="fp-column-head">
          <strong><%= t("flightplan.board.columns.#{column.key}") %></strong>
          <span class="fp-count"><%= column.count %></span>
          <% if column.key == "done" %>
            <%= link_to(@board.done_all? ? t("flightplan.board.done_recent") : t("flightplan.board.done_all"),
                  flightplan_board_path(@board.params_for(done: (@board.done_all? ? nil : "all"))),
                  data: { turbo: false }) %>
          <% end %>
        </header>
        <div class="fp-column-cards">
          <% if column.cards.empty? %>
            <p class="fp-empty"><%= t("flightplan.board.empty") %></p>
          <% end %>
          <% column.cards.each do |card| %>
            <%= tag.article class: "fp-card", draggable: true, data: {
                  fp_board_card: "1",
                  id: card.id,
                  lock_version: card.lock_version,
                  project: card.project_identifier,
                  subject: card.subject,
                  status: column.status,
                  labels: card.labels.map { |label| label[:name] }.to_json,
                  url: work_package_path(card.id),
                  column: column.key
                } do %>
              <div class="fp-card-line">
                <%= link_to "##{card.id}", work_package_path(card.id), class: "fp-id" %>
                <%= link_to t("flightplan.workplace.tab"), flightplan_workplace_path(card.id), class: "fp-badge", data: { turbo: false } %>
                <span class="fp-chip"><%= card.project_name %></span>
                <time datetime="<%= card.updated_at.iso8601 %>"><%= card.updated_at.strftime("%d.%m.%Y") %></time>
              </div>
              <h3 class="fp-card-title"><%= card.subject %></h3>
              <% if card.labels.any? %>
                <div class="fp-card-labels">
                  <% card.labels.each do |label| %>
                    <span class="fp-label-chip" style="background-color:#<%= label[:color] %>;color:#<%= label[:ink] %>"><%= label[:name] %></span>
                  <% end %>
                </div>
              <% end %>
              <div class="fp-card-meta">
                <% if card.assignee %>
                  <span class="fp-avatar" title="<%= [card.assignee.name, card.assignee.group].compact.join(" · ") %>"><%= card.assignee.initials %></span>
                  <% if card.assignee.group %>
                    <span class="fp-badge"><%= card.assignee.group %></span>
                  <% end %>
                <% end %>
                <% card.involved.each do |person| %>
                  <span class="fp-avatar -small" title="<%= [person.name, person.group].compact.join(" · ") %>"><%= person.initials %></span>
                <% end %>
                <% if card.pause %>
                  <span class="fp-badge"><%= t("flightplan.board.pause") %></span>
                <% end %>
                <% if card.execution_path.present? %>
                  <span class="fp-badge"><%= card.execution_path %></span>
                <% end %>
                <% if card.show_children %>
                  <span class="fp-badge" data-children="<%= card.children %>"><%= t("flightplan.board.children", count: card.children) %></span>
                <% end %>
                <% if card.question_count.positive? %>
                  <%= link_to t("flightplan.board.open_questions", count: card.question_count),
                        "/#q-#{card.question_id}",
                        class: "fp-badge",
                        data: { turbo: false } %>
                <% end %>
              </div>
            <% end %>
          <% end %>
          <% if column.count > column.shown %>
            <%= link_to t("flightplan.board.more", count: column.count - column.shown),
                  flightplan_board_path(@board.params_for(limits: @board.limits.merge(column.key => column.shown + Flightplan::Board::PAGE))),
                  class: "fp-more",
                  data: { turbo: false } %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</div>
