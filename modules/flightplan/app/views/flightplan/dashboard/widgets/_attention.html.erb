<% dash_path = ->(**opts) { main_app.root_path(**opts) } %>
<% groups = @dashboard.groups %>
<%# OP#1708: offene Rückfragen je Paket; die Zeile zeigt die Frage samt Antwortformular (Partial question_body). %>
<% questions_by_wp = (@questions_widget&.rows || []).group_by { |question| question[:work_package_id] } %>
<% entries = groups.flat_map { |group| group[:rows].map { |row| { bereich: row[:bereich], path: row[:project_path], statuses: [row[:status]], labels: row[:labels] } } } %>
<% filters = Flightplan::WidgetFilters.new(entries, tree: @dashboard.project_tree, status_order: @dashboard.status_order) %>
<%= render layout: "flightplan/dashboard/widget", locals: { key: "attention", title: t("flightplan.dashboard.attention.title"), title_id: "fp-dash-attention-title", filters: } do %>
  <p class="fp-dash-hint"><%= t("flightplan.dashboard.attention.hint", days: Flightplan::Dashboard::STALE_DAYS) %></p>

  <% if (unknown = @dashboard.unknown_bereich) %>
    <p class="fp-dash-hint" id="fp-unknown-bereich" role="status"><%= t("flightplan.dashboard.attention.unknown_bereich", name: unknown) %></p>
  <% end %>

  <nav class="fp-chips" aria-label="<%= t("flightplan.board.bereiche") %>">
    <%= link_to dash_path.(), class: "fp-chip #{'is-on' if @dashboard.selected_bereich.nil?}", data: { bereich: "all", turbo: false } do %>
      <%= t("flightplan.board.all") %>
      <span><%= @dashboard.total_count %></span>
    <% end %>
    <% @dashboard.bereich_choices.each do |choice| %>
      <%= link_to dash_path.(bereich: choice[:key]), class: "fp-chip #{'is-on' if choice[:selected]}", data: { bereich: choice[:key], turbo: false } do %>
        <%= choice[:label] %>
        <span><%= choice[:count] %></span>
      <% end %>
    <% end %>
  </nav>

  <% any_approvable = @approval_state == :ok && groups.any? { |group| group[:rows].any? { |row| row[:approvable] } } %>
  <%# OP#1708: Das Freigabeformular ist leer und wird über das Attribut form= bedient, weil die Zeilen jetzt eigene
      Antwortformulare enthalten (Formulare dürfen nicht verschachtelt sein). %>
  <%= form_with url: flightplan_approvals_create_path, method: :post, id: "fp-approve-form", local: true, data: { turbo: false } do %>
    <%= hidden_field_tag :bereich, @dashboard.selected_bereich, id: nil %>
  <% end %>
  <% if any_approvable %>
    <p class="fp-dash-bulk">
      <button type="submit" form="fp-approve-form" class="fp-approve-bulk" id="fp-approve-bulk"><%= t("flightplan.approvals.bulk") %></button>
      <span class="fp-dash-hint"><%= t("flightplan.approvals.hint") %></span>
    </p>
  <% end %>
  <% if groups.empty? || groups.all? { |group| group[:rows].empty? } %>
    <% if @dashboard.selected_bereich %>
      <p id="fp-dash-empty"><%= t("flightplan.dashboard.attention.empty_bereich", name: Flightplan::Dashboard::BEREICHE[@dashboard.selected_bereich]) %></p>
    <% else %>
      <p id="fp-dash-empty"><%= t("flightplan.dashboard.attention.empty") %></p>
    <% end %>
  <% end %>
  <% groups.each do |group| %>
    <% next if group[:rows].empty? %>
    <div class="fp-dash-group-block" data-fp-group>
    <h3 class="fp-dash-group" data-bereich-group="<%= group[:label] %>"><%= group[:label] %> <span class="fp-badge" data-fp-group-count><%= group[:rows].size %></span></h3>
    <div class="fp-dash-scroll">
    <table class="fp-dash-table" data-bereich-table="<%= group[:label] %>">
      <thead>
        <tr>
          <th scope="col"><%= t("flightplan.dashboard.attention.project") %></th>
          <th scope="col"><%= t("flightplan.dashboard.attention.id") %></th>
          <th scope="col"><%= t("flightplan.dashboard.attention.subject") %></th>
          <th scope="col"><%= t("flightplan.dashboard.attention.status") %></th>
          <th scope="col"><%= t("flightplan.dashboard.attention.agent") %></th>
          <th scope="col"><%= t("flightplan.dashboard.attention.age") %></th>
          <% if any_approvable %><th scope="col"><%= t("flightplan.dashboard.attention.approval") %></th><% end %>
        </tr>
      </thead>
      <tbody>
        <% group[:rows].each do |row| %>
          <%= tag.tr(data: { wp: row[:id], **Flightplan::WidgetFilters.item_data(bereich: row[:bereich], path: row[:project_path], statuses: [row[:status]], labels: row[:labels]) }) do %>
            <td><%= row[:project] %></td>
            <td><%= link_to "##{row[:id]}", flightplan_workplace_path(row[:id]), data: { turbo: false } %></td>
            <td>
              <%= link_to row[:subject], flightplan_workplace_path(row[:id]), data: { turbo: false } %>
              <% if row[:labels].present? %>
                <span class="fp-dash-labels"><% row[:labels].each do |name| %><span class="fp-dash-label"><%= name %></span><% end %></span>
              <% end %>
              <% if row[:reasons].map(&:to_s).include?("question") %>
                <% questions_by_wp[row[:id]]&.each do |question| %>
                  <%= tag.div(id: "q-#{question[:id]}", class: "fp-q fp-q--inline",
                              data: { fp_question: question[:id], fp_answered_text: t("flightplan.questions.widget.answered"),
                                      fp_sending_text: t("flightplan.questions.widget.sending"),
                                      fp_failed_text: t("flightplan.questions.widget.failed") }) do %>
                    <%= render "flightplan/dashboard/question_body", row: question, return_to: "home", selected_scope: nil, compact: true %>
                  <% end %>
                <% end %>
              <% end %>
            </td>
            <td>
              <span class="fp-badge" data-fp-status="<%= row[:status] %>"><%= row[:status] %></span>
              <% row[:reasons].each do |reason| %>
                <span class="fp-dash-reason" data-reason="<%= reason %>"><%= t("flightplan.dashboard.reasons.#{reason}") %></span>
              <% end %>
            </td>
            <td><%= row[:agent].presence || "–" %></td>
            <td class="fp-dash-age"><time datetime="<%= row[:since].iso8601 %>"><%= Flightplan::Dashboard.age_label(row[:age_seconds]) %></time></td>
            <% if any_approvable %>
              <td class="fp-dash-approve">
                <% if row[:approvable] %>
                  <%= check_box_tag "ids[]", row[:id], false, id: "fp-ap-#{row[:id]}", class: "fp-approve-check", form: "fp-approve-form", "aria-label": t("flightplan.approvals.select") %>
                  <%= hidden_field_tag "lock_versions[#{row[:id]}]", row[:lock_version], id: nil, form: "fp-approve-form" %>
                  <button type="submit" form="fp-approve-form" name="single" value="<%= row[:id] %>" class="fp-approve-one"><%= t("flightplan.approvals.button") %></button>
                <% end %>
              </td>
            <% end %>
          <% end %>
        <% end %>
      </tbody>
    </table>
    </div>
    </div>
  <% end %>
<% end %>
