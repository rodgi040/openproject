<%# OP#1673: offene Rückfragen aller Projekte, beantwortbar im Widget. Ersetzt die Seite /flightplan/questions.
    OP#1722: nur noch in der Leser-Ansicht (MEMBER_ORDER); Admins beantworten in „Aufmerksamkeit“ (OP#1708). %>
<% widget = @questions_widget %>
<% entries = widget.rows.map { |row| { bereich: row[:bereich], path: row[:project_path], statuses: [row[:status]], labels: row[:labels] } } %>
<% filters = Flightplan::WidgetFilters.new(entries, tree: widget.tree, status_order: widget.status_order) %>
<% return_to = "home" # OP#1721: nur noch die Hauptseite %>
<%= render layout: "flightplan/dashboard/widget", locals: { key: "questions", title: t("flightplan.questions.widget.title"), filters:, selected_scope: widget.selected_scope } do %>
  <% if widget.rows.empty? %>
    <p class="fp-dash-hint" id="fp-questions-empty"><%= t("flightplan.questions.empty") %></p>
  <% else %>
    <p class="fp-dash-hint"><%= t("flightplan.questions.widget.hint") %></p>
  <% end %>
  <% widget.groups.each do |group| %>
    <div class="fp-dash-group-block" data-fp-group data-questions-group="<%= group[:label] %>">
      <h3 class="fp-dash-group"><%= group[:label] %> <span class="fp-badge" data-fp-group-count><%= group[:rows].size %></span></h3>
      <% group[:rows].each do |row| %>
        <%= tag.article(id: "q-#{row[:id]}", class: "fp-q",
                        data: { fp_question: row[:id], fp_answered_text: t("flightplan.questions.widget.answered"),
                                fp_sending_text: t("flightplan.questions.widget.sending"), fp_failed_text: t("flightplan.questions.widget.failed"),
                                **Flightplan::WidgetFilters.item_data(bereich: row[:bereich], path: row[:project_path], statuses: [row[:status]], labels: row[:labels]) }) do %>
          <header class="fp-q-head">
            <span class="fp-q-project"><%= row[:project] %></span>
            <%= link_to "##{row[:work_package_id]}", flightplan_workplace_path(row[:work_package_id]), class: "fp-q-id", data: { turbo: false } %>
            <%= link_to row[:subject], flightplan_workplace_path(row[:work_package_id]), class: "fp-q-subject", data: { turbo: false } %>
            <span class="fp-badge" data-fp-status="<%= row[:status] %>"><%= row[:status] %></span>
            <% row[:labels].each do |name| %><span class="fp-dash-label"><%= name %></span><% end %>
            <span class="fp-q-meta">
              <span class="fp-q-agent"><%= row[:agent].presence || "–" %><% if row[:agent_group] %> <span class="Label Label--secondary">Agent · <%= row[:agent_group] %></span><% end %></span>
              <time class="fp-q-age" datetime="<%= row[:since].iso8601 %>" title="<%= l(row[:since], format: :short) %>"><%= Flightplan::Dashboard.age_label(row[:age_seconds]) %></time>
            </span>
          </header>
          <%= render "flightplan/dashboard/question_body", row:, return_to:, selected_scope: widget.selected_scope %>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>
