<section id="fp-home-chat"
         class="fp-home-chat"
         aria-label="<%= t("flightplan.home.chat") %>"
         data-chat-origin="<%= Flightplan::Workplace::CHAT_ORIGIN %>"
         data-csrf="<%= form_authenticity_token %>">
  <% if User.current.admin? %>
    <% if @questions_widget %>
      <script type="application/json" data-fp-chat-questions><%= json_escape(@questions_widget.chat_items.to_json).html_safe %></script>
    <% end %>
    <div class="fp-chat-offline" data-fp-chat-offline role="alert" hidden>
      <p><%= t("flightplan.workplace.chat_unreachable") %></p>
      <button type="button" data-fp-chat-reload><%= t("flightplan.workplace.chat_reload") %></button>
    </div>
    <iframe class="fp-home-frame"
            data-fp-home-frame
            hidden
            title="<%= t("flightplan.home.chat") %>"
            data-src="<%= Flightplan::Workplace::CHAT_ORIGIN %>/chat/"></iframe>
  <% else %>
    <p class="fp-dash-hint" data-fp-chat-admin-only><%= t("flightplan.home.chat_admin_only") %></p>
  <% end %>
</section>
