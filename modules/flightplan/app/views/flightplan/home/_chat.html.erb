<%# OP#1778: rechte Fläche des Splits. Nur das T3-iframe im Vollmodus (?layout=full: Seitenleiste, Kopfzeile wie
    Standalone); die Ticketauswahl steht links (home/_chat_picker). Nur für Admins gerendert (dashboard/index). %>
<section id="fp-home-chat"
         class="fp-home-chat"
         aria-label="<%= t("flightplan.home.chat") %>"
         data-chat-origin="<%= Flightplan::Workplace::CHAT_ORIGIN %>"
         data-csrf="<%= form_authenticity_token %>">
  <button type="button" class="fp-home-strip" data-fp-strip="split">
    <span class="fp-home-strip-text"><%= t("flightplan.home.tab_chat") %></span>
    <span class="fp-sr"><%= t("flightplan.home.strip_show") %></span>
  </button>
  <div class="fp-home-chat-body" data-fp-pane-body>
    <% if @questions_widget %>
      <script type="application/json" data-fp-chat-questions><%= json_escape(@questions_widget.chat_items.to_json).html_safe %></script>
    <% end %>
    <div class="fp-chat-offline" data-fp-chat-offline role="alert" hidden>
      <p><%= t("flightplan.workplace.chat_unreachable") %></p>
      <button type="button" data-fp-chat-reload><%= t("flightplan.workplace.chat_reload") %></button>
    </div>
    <iframe class="fp-home-frame"
            data-fp-home-frame
            hidden
            title="<%= t("flightplan.home.chat") %>"
            data-src="<%= Flightplan::Workplace::CHAT_ORIGIN %>/chat/?layout=full"></iframe>
  </div>
</section>
