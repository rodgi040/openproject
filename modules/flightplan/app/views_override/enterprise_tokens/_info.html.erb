<%# #1618: token entry only. Trial banner, chargebee script and benefits/upsell block removed. %>
<%=
  render(Primer::Beta::Subhead.new) do |subhead|
    subhead.with_heading(size: :medium) { EnterpriseToken.human_attribute_name(:encoded_token) }
    subhead.with_description { I18n.t("ee.upsell.already_have_token") }
  end
%>

<%=
  render(Primer::OpenProject::FlexLayout.new(mb: 1)) do |button_row|
    button_row.with_column do
      button_title = t("admin.enterprise.create_dialog.title")
      render(
        Primer::Beta::Button.new(
          tag: :a,
          scheme: :primary,
          mobile_label: button_title,
          mobile_icon: :plus,
          size: :medium,
          href: new_enterprise_token_path,
          aria: { label: button_title },
          role: "button",
          data: {
            turbo_stream: true
          },
          title: button_title
        )
      ) do |button|
        button.with_leading_visual_icon(icon: :plus)
        button_title
      end
    end
  end
%>
